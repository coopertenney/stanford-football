{
  "name": "stanford-football-player-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "tsx src/ingest/build.ts",
    "ingest:games": "tsx src/ingest/build.ts --games",
    "typecheck": "tsc --noEmit",
    "check": "python3 scripts/check.py",
    "check:data": "python3 scripts/check.py --only data"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
